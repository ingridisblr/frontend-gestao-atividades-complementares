
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }


:root {
    --brand:          #00B7B8;
    --brand-dark:     #00999a;
    --brand-light:    #e6f9f9;
    --bg:             #f4f6f9;
    --surface:        #ffffff;
    --sidebar-bg:     #0f1923;
    --sidebar-text:   #8a9ab0;
    --text-primary:   #1a2332;
    --text-secondary: #64748b;
    --text-muted:     #94a3b8;
    --border:         #e8edf3;

    --pending-bg:     #fff8e6;
    --pending-color:  #d97706;
    --approved-bg:    #e8faf2;
    --approved-color: #059669;
    --rejected-bg:    #fef0f0;
    --rejected-color: #dc2626;
    --total-bg:       #eff6ff;
    --total-color:    #3b82f6;
    --hours-bg:       #f5f3ff;
    --hours-color:    #7c3aed;
    --students-bg:    #eef2ff;
    --students-color: #4f46e5;

    --sidebar-width: 240px;
    --radius:        12px;
}

body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text-primary);
    display: flex;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
}

.sidebar {
    width: var(--sidebar-width);
    background: var(--sidebar-bg);
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0; left: 0; bottom: 0;
    z-index: 100;
}

.sidebar-logo {
    padding: 24px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
}

.sidebar-k-logo {
    width: 36px;
    height: 36px;
    object-fit: contain;
    flex-shrink: 0;
}

.sidebar-logo .brand-name {
    font-size: 18px;
    font-weight: 600;
    color: #fff;
    letter-spacing: 2px;
    line-height: 1.2;
}

.sidebar-logo .brand-sub {
    font-size: 11px;
    color: var(--sidebar-text);
    letter-spacing: 0.5px;
    margin-top: 1px;
}

.sidebar-nav {
    flex: 1;
    padding: 20px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    overflow-y: auto;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--sidebar-text);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.15s, color 0.15s;
    cursor: pointer;
    min-height: 44px; 
}

.nav-item:hover  { background: rgba(255,255,255,0.06); color: #fff; }
.nav-item.active { background: rgba(0,183,184,0.15); color: var(--brand); }
.nav-item svg    { width: 18px; height: 18px; flex-shrink: 0; }

.sidebar-footer {
    padding: 16px 12px;
    border-top: 1px solid rgba(255,255,255,0.06);
    flex-shrink: 0;
}

.main {
    margin-left: var(--sidebar-width);
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}
.topbar {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 0 32px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 50;
}

.topbar-user .user-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    display: block;
}

.topbar-user .user-email {
    font-size: 13px;
    color: var(--text-secondary);
}

.btn-logout {
    display: flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    cursor: pointer;
    padding: 8px 14px;
    border-radius: 8px;
    transition: background 0.15s, color 0.15s;
    min-height: 44px; /* PWA: touch target */
}

.btn-logout:hover { background: var(--bg); color: var(--text-primary); }
.btn-logout svg   { width: 16px; height: 16px; }

.content {
    padding: 32px;
    flex: 1;
}

.page-title {
    font-size: 26px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
}

.page-subtitle {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 28px;
}

.page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 28px;
    gap: 16px;
}

.page-header .page-title    { margin-bottom: 4px; }
.page-header .page-subtitle { margin-bottom: 0; }

.card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
}

.card-header {
    padding: 20px 24px;
    border-bottom: 1px solid var(--border);
}

.card-header h2 {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
}

.skeleton {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.4s infinite;
    border-radius: 6px;
}

@keyframes shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}

.empty-state,
.empty-table {
    text-align: center;
    padding: 48px 24px;
    color: var(--text-muted);
    font-size: 14px;
}

.tabela {
    width: 100%;
    border-collapse: collapse;
}

.tabela thead tr { border-bottom: 1px solid var(--border); }

.tabela th {
    padding: 14px 24px;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
    color: var(--brand);
    white-space: nowrap;
}

.tabela td {
    padding: 18px 24px;
    font-size: 14px;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
}

.tabela tbody tr:last-child td { border-bottom: none; }
.tabela tbody tr:hover td      { background: #fafbfc; }

.loading-cell {
    padding: 40px 24px !important;
    text-align: center;
}
.acoes { display: flex; align-items: center; gap: 6px; }

.btn-acao {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
}

.btn-acao svg      { width: 17px; height: 17px; }
.btn-acao.editar   { color: var(--text-secondary); }
.btn-acao.editar:hover   { background: #f1f5f9; color: var(--text-primary); }
.btn-acao.deletar  { color: #dc2626; }
.btn-acao.deletar:hover  { background: #fef2f2; }

.badge {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
}

.btn-cancelar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    background: var(--surface);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s;
    min-height: 44px; 
}

.btn-cancelar:hover { background: var(--bg); color: var(--text-primary); }

.btn-salvar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    background: var(--brand);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
    min-height: 44px; 
}

.btn-salvar:hover    { background: var(--brand-dark); }
.btn-salvar:disabled { opacity: 0.6; cursor: not-allowed; }

.busca-card    { padding: 16px 20px; margin-bottom: 16px; }

.busca-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
}

.busca-icon  { width: 18px; height: 18px; color: var(--text-muted); flex-shrink: 0; }

.busca-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    color: var(--text-primary);
    background: transparent;
    min-height: 44px; 
}

.busca-input::placeholder { color: var(--text-muted); }

.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
}

.form-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
}

.form-input {
    width: 100%;
    padding: 11px 13px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-primary);
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
    min-height: 44px; 
}

.form-input:focus        { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(0,183,184,0.08); }
.form-input::placeholder { color: var(--text-muted); }
.form-input.input-erro   { border-color: #dc2626; }
.form-input.input-erro:focus { border-color: #dc2626; box-shadow: none; }

textarea.form-input         { resize: vertical; min-height: 90px; }
input[type="file"].form-input { padding: 9px 12px; cursor: pointer; }

.form-help { font-size: 12px; color: var(--text-muted); }

.modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15,23,42,0.45);
    backdrop-filter: blur(2px);
    z-index: 200;
}

.modal-overlay.open { display: block; }

.modal {
    display: none;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--surface);
    border-radius: var(--radius);
    width: calc(100% - 32px);
    max-width: 480px;
    max-height: 90vh;    
    overflow: hidden;   
    z-index: 201;
    box-shadow: 0 20px 60px rgba(0,0,0,0.15);
}

.modal.open {
    display: flex;       
    flex-direction: column;
    animation: modalIn 0.2s ease;
}

.modal > form {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

@keyframes modalIn {
    from { opacity: 0; transform: translate(-50%, -48%); }
    to   { opacity: 1; transform: translate(-50%, -50%); }
}

.modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    flex-shrink: 0; 
}

.modal-header h3,
.modal-titulo {
    font-size: 17px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
}

.modal-close,
.modal-fechar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: background 0.15s;
    flex-shrink: 0;
}

.modal-close:hover,
.modal-fechar:hover { background: var(--bg); color: var(--text-primary); }

.modal-body {
    flex: 1 1 auto;
    min-height: 0;       
    padding: 24px;
    overflow-y: auto;    
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(0,0,0,0.12) transparent;
}

.modal-body::-webkit-scrollbar       { width: 5px; }
.modal-body::-webkit-scrollbar-track { background: transparent; }
.modal-body::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.12); border-radius: 99px; }

.modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 16px 24px;
    border-top: 1px solid var(--border);
    background: var(--surface);
    flex-shrink: 0; 
}

.toast {
    position: fixed;
    bottom: 28px;
    right: 28px;
    background: #1a2332;
    color: #fff;
    padding: 12px 18px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.25s, transform 0.25s;
    pointer-events: none;
    z-index: 999;
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
}

.toast.show { opacity: 1; transform: translateY(0); }

.stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 24px;
}

.stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: box-shadow 0.2s;
}

.stat-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.06); }

.stat-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 8px;
}

.stat-value {
    font-size: 36px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1;
}

.stat-unit {
    font-size: 20px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-left: 2px;
}

.stat-icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.stat-icon svg      { width: 24px; height: 24px; }
.stat-icon.total    { background: var(--total-bg);    color: var(--total-color); }
.stat-icon.pending  { background: var(--pending-bg);  color: var(--pending-color); }
.stat-icon.approved { background: var(--approved-bg); color: var(--approved-color); }
.stat-icon.rejected { background: var(--rejected-bg); color: var(--rejected-color); }
.stat-icon.hours    { background: var(--hours-bg);    color: var(--hours-color); }
.stat-icon.students { background: var(--students-bg); color: var(--students-color); }

.activity-list { list-style: none; }

.activity-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: background 0.15s;
}

.activity-item:last-child { border-bottom: none; }
.activity-item:hover      { background: #fafbfc; }

.activity-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: #eff6ff;
    color: #3b82f6;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.activity-icon svg { width: 18px; height: 18px; }

.activity-info {
    flex: 1;
    min-width: 0;
}

.activity-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.activity-detail {
    font-size: 13px;
    color: var(--text-secondary);
}

.activity-date {
    font-size: 12px;
    color: var(--text-muted);
    font-family: 'DM Mono', monospace;
    white-space: nowrap;
    flex-shrink: 0;
}

.activity-list .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 48px 24px;
    color: var(--text-muted);
    font-size: 14px;
    cursor: default;
}

.activity-list .empty-state svg { width: 32px; height: 32px; opacity: 0.4; }

.filtros-card { padding: 20px 24px; margin-bottom: 16px; }

.filtros-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.badge.pendente,
.badge.enviada   { background: var(--pending-bg);  color: var(--pending-color); }
.badge.aprovada  { background: var(--approved-bg); color: var(--approved-color); }
.badge.reprovada { background: var(--rejected-bg); color: var(--rejected-color); }

.btn-ver-detalhes {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    min-height: 44px; 
}

.btn-ver-detalhes svg { width: 15px; height: 15px; flex-shrink: 0; }

.btn-ver-detalhes:hover {
    background: var(--bg);
    color: var(--text-primary);
    border-color: var(--text-muted);
}

@media (max-width: 768px) {
    .sidebar { transform: translateX(-100%); transition: transform 0.3s; }
    .main    { margin-left: 0; }
    .content { padding: 20px 16px; }
    .topbar  { padding: 0 16px; }

    .stats-grid    { grid-template-columns: 1fr 1fr; }
    .filtros-grid  { grid-template-columns: 1fr; }
    .activity-date { display: none; }
    .activity-item { padding: 14px 16px; }

    .modal {
        width: calc(100% - 24px);
        max-height: 92vh;
    }

    .modal-footer              { flex-direction: column-reverse; }
    .modal-footer button       { width: 100%; }
}

@media (max-width: 480px) {
    .stats-grid { grid-template-columns: 1fr; }
}

@media (max-width: 900px) {
    .page-header {
        flex-direction: column;
        align-items: stretch;
    }

    .stat-card {
        min-width: 0;
    }

    .activity-item {
        align-items: flex-start;
    }

    .activity-detail {
        overflow-wrap: anywhere;
    }
}

@media (max-width: 640px) {
    .topbar {
        height: auto;
        min-height: 64px;
        padding-top: 12px;
        padding-bottom: 12px;
    }

    .stat-card {
        padding: 18px;
    }

    .stat-value {
        font-size: 30px;
    }

    .activity-item {
        gap: 10px;
    }
}
